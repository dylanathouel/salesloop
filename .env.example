# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (used by docker-compose)
DB_USER=salesloop
DB_PASSWORD=change-me
DB_NAME=salesloop

# Auth
JWT_SECRET=change-me-long-random-string

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Embeddings (RAG) — any OpenAI-compatible endpoint.
# Leave EMBEDDING_API_KEY empty to disable RAG (training uploads are stored
# unembedded and the trainer agent works without document retrieval).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
